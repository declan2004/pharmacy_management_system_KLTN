<IfModule mod_rewrite.c>
    RewriteEngine On
    # Nếu là file hoặc thư mục có thật thì cho phép truy cập trực tiếp (css, js, images)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    # Nếu không, chuyển tất cả thành tham số cho index.php
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>